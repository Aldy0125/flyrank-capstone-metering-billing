# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

APP_NAME=usage-metering-billing
APP_ENV=development
LOG_LEVEL=INFO


# ==========================================
# POSTGRESQL CONFIGURATION
# ==========================================

POSTGRES_DB=usage_billing
POSTGRES_USER=usage_app
POSTGRES_PASSWORD=local_dev_password_change_me
POSTGRES_PORT=5432


# ==========================================
# DATABASE CONNECTION
# ==========================================

DATABASE_URL=postgresql+psycopg://usage_app:local_dev_password_change_me@localhost:5432/usage_billing


# ==========================================
# STRIPE CONFIGURATION (TEST MODE ONLY)
# ==========================================

STRIPE_SECRET_KEY=sk_test_replace_with_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_webhook_signing_secret
STRIPE_PRO_PRICE_ID=price_replace_with_pro_price_id


# ==========================================
# INNGEST CONFIGURATION
# ==========================================

INNGEST_APP_ID=usage-metering-billing
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:8000/docs?checkout=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:8000/docs?checkout=cancel